# Keep every file byte-for-byte as Hammer / the Workshop Tools wrote it:
# no line ending conversion (Source 2 assets such as .vmdl, .vmat, .vsndevts
# are text files, but they must not be touched by Git).
* -text

# Repository documentation and config: always LF
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf

# Hammer map files: no text diffs
*.vmap binary

# Git LFS only for very large working files that can exceed GitHub's 100 MB
# file limit (run `git lfs install` once). Everything else is stored as
# regular Git files: no LFS bandwidth quota, simple clone / ZIP download.
*.psd filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
