	"child_event.rain.waterflow" = 
	{
		base = "amb.looping.stereo.base"
		volume = 0.149902
		pitch = 1.0
		randomize_start_time = true
		use_distance_volume_mapping_curve = true
		occlusion_intensity = 0.8
		use_fadetime_volume_mapping_curve = false
		restrict_source_reverb = true
		instance_limit = 1.0
		vsnd_files_track_01 = "sounds/ambient/common/water/water_flow_loop1.vsnd"
		distance_volume_mapping_curve = 
