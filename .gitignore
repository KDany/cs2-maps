# Ignore compiled game files (only save content)
game/
*.vpk

# Ignore Hammer automatic backups / autosaves
*.bak
*.bak[0-9]
*_bak.vmap
**/maps/autosave/

# Ignore compile logs and preview files
*.log
**/preview/
*.vrmanifest

# Ignore system and editor temp files
.vs/
*.suo
*.user
Thumbs.db
desktop.ini
.DS_Store

# Decompiled world data inside maps/<map_name>/ (not needed to open the .vmap)
**/maps/*/world.vwrld

# Decompiled world collision (regenerated from the .vmap on build)
**/maps/*/world_physics*

# Generated night variant of a map (re-created from <map_name>.vmap before each release, see README)
**/maps/*_night.vmap
